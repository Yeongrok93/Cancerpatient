# Neon Postgres — Vercel의 Neon 연동이 자동으로 등록함 (로컬은 Neon 콘솔에서 복사)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# 스키마 적용 등 풀러를 거치지 않는 연결용 (앱 코드는 사용하지 않음)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# 관리자 페이지(/admin) 로그인 — 아이디(기본값 admin)와 비밀번호
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 솔라피 (참여신청 문자 알림) — 솔라피 콘솔 > API Key 관리
# 주의: 같은 키를 다른 프로젝트와 공유 중이면 재발급 시 모든 곳의 값을 함께 바꿔야 함
SOLAPI_API=NCSxxxxxxxxxxxxx
SOLAPI_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 참여신청 문자 알림 (필수) — 솔라피에 등록된 발신번호, 수신번호(쉼표 구분)
SMS_SENDER=01012345678
SMS_NOTIFY_TO=01012345678,01087654321
